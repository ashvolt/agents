      "x": 40,
      "y": 1670,
      "width": 766.08,
      "height": 22.5,
      "text": "Everything else - frameworks, multi-agent, MCP - is decoration on this loop.",
      "fontSize": 18,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Everything else - frameworks, multi-agent, MCP - is decoration on this loop.",
      "lineHeight": 1.25,
      "autoResize": true
    },
    {
      "angle": 0,
      "strokeColor": "#e03131",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
