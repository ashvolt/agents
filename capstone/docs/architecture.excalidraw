      "x": 703.4399999999999,
      "y": 2120.0,
      "width": 393.12000000000006,
      "height": 65.0,
      "text": "CONTROL ARM:  --no-tools\nsame cases, deterministic tools disabled.\nthe gap between the two runs is the MEASURED\nvalue of the code/model split. measured, not asserted.",
      "fontSize": 13,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "middle",
