      "locked": false,
      "id": "el1085",
      "type": "text",
      "x": 40,
      "y": 1710,
      "width": 595.84,
      "height": 52.5,
      "text": "The API is STATELESS: every turn resends the whole conversation as input.\nInput tokens grow each turn, so cost is quadratic in turn count, not linear.\nThat is why L0 makes you write estimate_cost() before anything else.",
      "fontSize": 14,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "The API is STATELESS: every turn resends the whole conversation as input.\nInput tokens grow each turn, so cost is quadratic in turn count, not linear.\nThat is why L0 makes you write estimate_cost() before anything else.",
      "lineHeight": 1.25,
      "autoResize": true
    },
