      "type": "text",
      "x": 1168.0,
      "y": 1333.0,
      "width": 364.00000000000006,
      "height": 130.0,
      "text": "MEASURED ON THE SAME 50 CASES\n                         tool loop     single call\n   auto-approve              72.7%          81.8%\n   false-approve             33.3%          18.2%\n   safe-zone recall            1/7            4/7\n   cost / file             $0.0117        $0.0067\n\nWORSE *AND* COSTLIER. removed.",
      "fontSize": 13,
      "fontFamily": 3,
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "el1085",
      "originalText": "MEASURED ON THE SAME 50 CASES\n                         tool loop     single call\n   auto-approve              72.7%          81.8%\n   false-approve             33.3%          18.2%\n   safe-zone recall            1/7            4/7\n   cost / file             $0.0117        $0.0067\n\nWORSE *AND* COSTLIER. removed.",
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
